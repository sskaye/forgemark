{
  "name": "forgemark",
  "private": true,
  "version": "1.6.0",
  "type": "module",
  "description": "Collaborative review of markdown documents by humans and AI agents.",
  "bin": {
    "forgemark": "assets/forgemark-skill/scripts/forgemark.mjs"
  },
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "vite:dev": "vite",
    "vite:build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:perf": "PERF=1 vitest run tests/perf tests/integration/rendered-perf.test.tsx",
    "build:cli": "node scripts/build-cli.mjs",
    "build:skill": "node scripts/build-cli.mjs && node scripts/build-skill.mjs",
    "cli": "vite-node cli/main.ts --",
    "version:set": "node scripts/set-version.mjs",
    "version:check": "node scripts/set-version.mjs --check",
    "build:icons": "tauri icon assets/forgemark-icon.svg --output src-tauri/icons",
    "release": "node scripts/release.mjs",
    "verify-ai-output": "node assets/forgemark-skill/scripts/forgemark.mjs lint",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css,html}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css,html}\"",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.42.1",
    "@tauri-apps/api": "^2.4.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-fs": "^2.2.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tiptap/extension-code": "^3.22.5",
    "@tiptap/extension-image": "^3.22.5",
    "@tiptap/extension-link": "^3.22.5",
    "@tiptap/extension-subscript": "^3.22.5",
    "@tiptap/extension-superscript": "^3.22.5",
    "@tiptap/extension-table": "^3.22.5",
    "@tiptap/extension-table-cell": "^3.22.5",
    "@tiptap/extension-table-header": "^3.22.5",
    "@tiptap/extension-table-row": "^3.22.5",
    "@tiptap/extension-task-item": "^3.22.5",
    "@tiptap/extension-task-list": "^3.22.5",
    "@tiptap/react": "^3.22.5",
    "@tiptap/starter-kit": "^3.22.5",
    "entities": "^6.0.1",
    "markdown-it": "^14.1.0",
    "parse5": "^7.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tiptap-markdown": "^0.9.0",
    "yaml": "^2.8.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.0",
    "@tauri-apps/cli": "^2.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^25.6.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.12",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "fast-check": "^4.7.0",
    "jsdom": "^25.0.1",
    "jszip": "^3.10.1",
    "prettier": "^3.4.2",
    "typescript": "~5.6.3",
    "vite": "^6.0.3",
    "vite-node": "^2.1.8",
    "vitest": "^2.1.8",
    "wait-on": "^9.1.0"
  }
}
